---
import { t } from "../lib/i18n";
import { renderEntryCard } from "../lib/render";
import type { FeedEntry, Lang } from "../lib/types";

interface Props {
  lang: Lang;
  entry: FeedEntry;
  context: "feed" | "thread";
  headingLevel?: 2 | 3;
}
const { lang, entry, context, headingLevel = 3 } = Astro.props;
const html = renderEntryCard(entry, t(lang).card, { context, headingLevel });
---

<Fragment set:html={html} />
