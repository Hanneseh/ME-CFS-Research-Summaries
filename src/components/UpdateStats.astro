---
import type { Update } from "../lib/content";
import { t } from "../lib/i18n";
import type { Lang } from "../lib/types";

interface Props {
  lang: Lang;
  update: Update;
}
const { lang, update } = Astro.props;
const parts = t(lang).upd.stats(update.counts.added, update.counts.upgraded, update.counts.threads);
---

<p class="update-stats num">
  {
    parts.map((p, i) => (
      <>
        {i > 0 && <span aria-hidden="true">·</span>}
        <span>{p}</span>
      </>
    ))
  }
</p>
