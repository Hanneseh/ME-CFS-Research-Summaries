---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchDialog from "../components/SearchDialog.astro";
import { t } from "../lib/i18n";
import { BASE, url } from "../lib/paths";
import type { Lang } from "../lib/types";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path below the language segment, e.g. "threads/foo/". Used for the language switch and hreflang. */
  subpath?: string;
  active?: "overview" | "feed" | "glossary" | "imprint" | "thread";
}

const { lang, title, description, subpath = "", active } = Astro.props;
const s = t(lang);
const pageTitle = title ? `${title} · ${s.brand}` : s.siteTitle;
const desc = description || s.siteDescription;
const site = Astro.site?.toString().replace(/\/+$/, "") ?? "";
const alt = (l: Lang) => site + url(l + "/" + subpath);
const canonical = alt(lang);
---

<!doctype html>
<html lang={s.htmlLang} data-base={BASE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var d = document.documentElement, s = null;
        try { s = localStorage.getItem("theme"); } catch (e) {}
        var dark = s ? s === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        d.setAttribute("data-theme", dark ? "dark" : "light");
        d.classList.add("js");
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={alt("de")} />
    <link rel="alternate" hreflang="en" href={alt("en")} />
    <link rel="alternate" hreflang="x-default" href={alt("en")} />
    <link rel="icon" type="image/svg+xml" href={url("favicon.svg")} />
    <meta name="theme-color" content="#FAF9F5" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={s.brand} />
    <meta property="og:title" content={title ?? s.siteTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>
    <Header lang={lang} subpath={subpath} active={active} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchDialog lang={lang} />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
